    {
      "parameters": {
        "jsCode": "// 获取所有用户数据项\nconst allUserData = $('Get many database pages').all();\n\n// 获取所有风格数据\nconst allStylesData = $input.all();\n\n// 存储所有匹配结果\nconst results = [];\n\n// 遍历每个用户数据项\nfor (const userItem of allUserData) {\n  // 获取当前项的文案风格\n  const selectedStyle = userItem.json.properties[\"文案风格\"].select.name;\n  \n  let styleContent = null;\n  \n  // 在风格数据中查找匹配的风格\n  for (const styleItem of allStylesData) {\n    // 检查styleItem.json中是否包含所选风格\n    if (styleItem.json && styleItem.json[selectedStyle]) {\n      styleContent = styleItem.json[selectedStyle];\n      break;\n    }\n    \n    // 如果直接在styleItem中查找（备用匹配方式）\n    if (styleItem[selectedStyle]) {\n      styleContent = styleItem[selectedStyle];\n      break;\n    }\n  }\n  \n  // 将匹配结果添加到结果数组\n  results.push({\n    json: {\n      originalData: userItem.json, // 保留原始数据\n      selectedStyle: selectedStyle,\n      styleContent: styleContent,\n      found: styleContent !== null\n    }\n  });\n}\n\n// 返回所有匹配结果\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
