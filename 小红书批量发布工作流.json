    {
      "parameters": {
        "jsCode": "// 获取所有输入数据\nconst allInputData = $input.all();\n\n// 存储所有处理结果\nconst results = [];\n\n// 遍历每个输入项\nfor (const inputItem of allInputData) {\n  // 获取当前项的HTML内容\n  let htmlContent = inputItem.json.data || '';\n  const originalContent = htmlContent;\n\n  if (!htmlContent) {\n    results.push({\n      json: {\n        originalData: inputItem.json, // 保留原始数据\n        cleanText: '',\n        originalLength: 0,\n        cleanLength: 0,\n        wordCount: 0\n      }\n    });\n    continue;\n  }\n\n  // 去除script和style标签及其内容\n  htmlContent = htmlContent.replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '');\n  htmlContent = htmlContent.replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '');\n\n  // 为块级元素添加换行标记\n  const blockElements = [\n    'div', 'p', 'br', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',\n    'li', 'ul', 'ol', 'blockquote', 'pre', 'hr', 'table',\n    'tr', 'td', 'th', 'header', 'footer', 'section', 'article',\n    'nav', 'main', 'aside'\n  ];\n\n  blockElements.forEach(tag => {\n    const regex = new RegExp(`<\\\\/?${tag}[^>]*>`, 'gi');\n    htmlContent = htmlContent.replace(regex, '\\n');\n  });\n\n  // 去除所有剩余的HTML标签\n  htmlContent = htmlContent.replace(/<[^>]*>/g, '');\n\n  // 解码常见的HTML实体\n  const htmlEntities = {\n    \"&amp;\": \"&\",\n    \"&lt;\": \"<\",\n    \"&gt;\": \">\",\n    \"&quot;\": \"\\\"\",\n    \"&#39;\": \"'\",\n    \"&apos;\": \"'\",\n    \"&nbsp;\": \" \",\n    \"&copy;\": \"©\",\n    \"&reg;\": \"®\",\n    \"&trade;\": \"™\",\n    \"&hellip;\": \"…\",\n    \"&mdash;\": \"—\",\n    \"&ndash;\": \"–\",\n    \"&lsquo;\": \"'\",\n    \"&rsquo;\": \"'\",\n    \"&ldquo;\": \"\\\"\",\n    \"&rdquo;\": \"\\\"\"\n  };\n\n  Object.keys(htmlEntities).forEach(entity => {\n    const regex = new RegExp(entity, 'g');\n    htmlContent = htmlContent.replace(regex, htmlEntities[entity]);\n  });\n\n  // 解码数字HTML实体（如 &#123;）\n  htmlContent = htmlContent.replace(/&#(\\d+);/g, (match, dec) => {\n    return String.fromCharCode(dec);\n  });\n\n  // 解码十六进制HTML实体（如 &#x7B;）\n  htmlContent = htmlContent.replace(/&#x([0-9A-Fa-f]+);/g, (match, hex) => {\n    return String.fromCharCode(parseInt(hex, 16));\n  });\n\n  // 清理和格式化文本\n  htmlContent = htmlContent\n    .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')  // 三个或更多连续换行合并为两个\n    .replace(/[ \\t]+/g, ' ')            // 多个连续空格/制表符合并为一个空格\n    .replace(/^\\s+|\\s+$/g, '')          // 去除首尾空白\n    .replace(/\\n /g, '\\n')              // 去除行首空格\n    .replace(/ \\n/g, '\\n')              // 去除行尾空格\n    .replace(/\\n{3,}/g, '\\n\\n');        // 确保最多只有两个连续换行\n\n  // 将处理结果添加到结果数组\n  results.push({\n    json: {\n      // originalData: inputItem.json, // 保留原始数据\n      cleanText: htmlContent,\n      originalLength: originalContent.length,\n      cleanLength: htmlContent.length,\n      wordCount: htmlContent.trim() ? htmlContent.trim().split(/\\s+/).length : 0\n    }\n  });\n}\n\n// 返回所有处理结果\nreturn results;\n"
      },
