    {
      "parameters": {
        "jsCode": "// 获取用户选择的风格\nconst selectedStyle = $('On form submission').first().json[\"文案风格\"];\n\n// 获取所有风格数据\nconst allStylesData = $input.all();\n\nlet styleContent = null;\n\n// 遍历所有输入数据，查找匹配的风格\nfor (const item of allStylesData) {\n  // 检查item.json中是否包含所选风格\n  if (item.json && item.json[selectedStyle]) {\n    styleContent = item.json[selectedStyle];\n    break;\n  }\n  \n  // 如果直接在item中查找（备用匹配方式）\n  if (item[selectedStyle]) {\n    styleContent = item[selectedStyle];\n    break;\n  }\n}\n\n// 返回匹配结果\nreturn [{\n  json: {\n    selectedStyle: selectedStyle,\n    styleContent: styleContent,\n    found: styleContent !== null\n  }\n}];\n"
      },
