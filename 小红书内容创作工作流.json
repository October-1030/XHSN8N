        "jsCode": "// 获取关键词字符串\nconst keywords = $('AI Agent').item.json.output.Pic_Keywords;\n\n// 获取文本数据\nconst inputData = $('AI Agent').item.json.output.Pic_Sentences;\n\n// 处理关键词\nconst keywordArray = keywords.split(',').map(keyword => keyword.trim());\nconst randomKeyword = keywordArray[Math.floor(Math.random() * keywordArray.length)];\n\n// 处理文本拆分（title固定2行，info为剩余内容）\nconst segments = inputData.split('\\n').filter(item => item.trim() !== '');\nconst titleLines = 2;\nconst titleParts = segments.slice(0, titleLines);\nconst infoParts = segments.slice(titleLines);\nconst title = titleParts.join('\\n');\nconst info = infoParts.length > 0 ? infoParts.join('\\n') : '';\n\n// 返回n8n格式的结果\nreturn [\n  {\n    json: {\n      // 关键词处理结果\n      randomKeyword: randomKeyword,\n      allKeywords: keywordArray,\n      totalCount: keywordArray.length,\n      \n      // 文本拆分结果\n      title: title,\n      info: info,\n      original: inputData,\n      segments_count: segments.length\n    }\n  }\n];\n"
      },
