    {
      "parameters": {
        "jsCode": "// 获取文本数据\nconst inputData = $('AI Agent').item.json.output.Pic_Sentences;\n\n// 获取最大值数据\nconst maxValue = $('Edit Fields1').first().json.bignum;\n\n// 处理文本拆分（title固定2行，info为剩余内容）\nconst segments = inputData.split('\\n').filter(item => item.trim() !== '');\n\n// 固定规则：title取前2行，info取剩余行\nconst titleLines = 2;\nconst titleParts = segments.slice(0, titleLines);\nconst infoParts = segments.slice(titleLines);\n\n// 处理边界情况\nconst title = titleParts.join('\\n');\nconst info = infoParts.length > 0 ? infoParts.join('\\n') : '';\n\n// 生成随机数\nconst randomNumber = Math.floor(Math.random() * maxValue) + 1;\n\n// 返回合并后的结果\nreturn [\n  {\n    json: {\n      // 文本拆分结果\n      title: title,\n      info: info,\n      original: inputData,\n      segments_count: segments.length,\n      title_segments: titleParts.length,\n      \n      // 随机数结果\n      randomNumber: randomNumber,\n      maxValue: maxValue\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
